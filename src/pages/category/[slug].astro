---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';

export const CATEGORY_CONFIG = {
  'ai-dx': {
    label: 'AI・DX',
    icon: '🤖',
    description: 'ChatGPT・Claude・GeminiなどAIツールの業務活用とDX推進の実践記録。',
  },
  shikaku: {
    label: '資格・学習',
    icon: '📖',
    description: '資格取得・学習の記録。合格体験だけでなく詰まった場所や工夫した勉強法を中心に。',
  },
  shigoto: {
    label: '仕事術・キャリア形成',
    icon: '💼',
    description: 'DX推進の現場で感じた壁や気づき、キャリア形成にまつわる実体験。',
  },
  shogi: {
    label: '将棋',
    icon: '歩',
    iconImage: '/images/icons/shogi-piece.svg',
    description: '四間飛車党による体験記・戦型別対策・棋書レビュー・雑記等。',
  },
};

export function matchesCategory(slug, data) {
  if (slug === 'shogi') return (data.section ?? 'shogi') === 'shogi';
  const cats = data.categories ?? [];
  if (slug === 'ai-dx') return cats.includes('AIツール');
  if (slug === 'shikaku') return cats.includes('資格・学習');
  if (slug === 'shigoto') {
    return cats.some((c) => ['DX・業務改善', '書籍レビュー', '仕事術・キャリア形成', 'コラム'].includes(c));
  }
  return false;
}

export function getStaticPaths() {
  return Object.keys(CATEGORY_CONFIG).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const cfg = CATEGORY_CONFIG[slug];

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => matchesCategory(slug, p.data))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={cfg.label} description={cfg.description}>
  <article>
    <h1 class="category-title">
      <CategoryIcon icon={cfg.icon} iconImage={cfg.iconImage} class="category-title-icon" />
      <span>{cfg.label}</span>
    </h1>
    <p class="category-description">{cfg.description}</p>

    {posts.length === 0 ? (
      <p>記事はまだ投稿されていません。</p>
    ) : (
      <div class="posts-list">
        {posts.map((post) => (
          <div class="post-item">
            {post.data.heroImage && (
              <a href={`/blog/${post.slug}`} class="post-thumb-link" tabindex="-1" aria-hidden="true">
                <img src={post.data.heroImage} alt="" class="post-thumb" loading="lazy" />
              </a>
            )}
            <div class="post-body">
            <h2>
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('ja-JP', {
                  year: 'numeric',
                  month: '2-digit',
                  day: '2-digit',
                })}
              </time>
              {post.data.author && <span class="author">著者: {post.data.author}</span>}
            </div>
            {post.data.description && (
              <p class="post-description">{post.data.description}</p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <a href={`/blog/${post.slug}`} class="read-more">記事を読む →</a>
            </div>
          </div>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .category-description {
    color: #718096;
    margin-bottom: 2rem;
  }

  .category-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-item {
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    transition: all 0.2s;
    display: grid;
    grid-template-columns: minmax(180px, 32%) 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .post-thumb-link { display: block; }
  .post-thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; display: block; }
  .post-body { min-width: 0; }

  .post-item:hover {
    border-color: #3182ce;
    box-shadow: 0 2px 8px rgba(49, 130, 206, 0.1);
  }

  .post-item h2 {
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
  }

  .post-item h2 a {
    color: #1a365d;
    text-decoration: none;
  }

  .post-item h2 a:hover {
    color: #3182ce;
    text-decoration: underline;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: #718096;
  }

  time {
    font-weight: 500;
  }

  .author {
    color: #a0aec0;
  }

  .post-description {
    color: #4a5568;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .tag {
    display: inline-block;
    background: #edf2f7;
    color: #2d3748;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .read-more {
    display: inline-block;
    color: #3182ce;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .read-more:hover {
    color: #1a365d;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .post-item { grid-template-columns: 1fr; }
  }
</style>
