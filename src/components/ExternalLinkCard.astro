---
interface Props {
  url: string;
  title: string;
  description: string;
  siteName: string;
  kind?: 'shogi' | 'app' | 'web';
}

const { url, title, description, siteName, kind = 'web' } = Astro.props;
---

<a class="external-link-card" href={url} target="_blank" rel="noopener noreferrer">
  <span class:list={['external-link-icon', `is-${kind}`]} aria-hidden="true">
    {kind === 'shogi' ? (
      <img src="/images/icons/shogi-piece.svg" alt="" />
    ) : kind === 'app' ? (
      <span class="app-mark">A</span>
    ) : (
      <span class="web-mark">↗</span>
    )}
  </span>
  <span class="external-link-content">
    <strong>{title}</strong>
    <span class="external-link-description">{description}</span>
    <span class="external-link-site">{siteName} <span aria-hidden="true">↗</span></span>
  </span>
</a>

<style>
  .external-link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.25rem 0;
    padding: 1rem 1.1rem;
    color: #1e293b;
    text-decoration: none;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .external-link-card:hover {
    color: #1e293b;
    text-decoration: none;
    border-color: #3b82f6;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
    transform: translateY(-1px);
  }

  .external-link-icon {
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, #eff6ff, #dbeafe);
  }

  .external-link-icon img { width: 34px; height: 42px; }
  .external-link-icon.is-app { background: linear-gradient(135deg, #38bdf8, #2563eb); }
  .external-link-icon.is-web { background: linear-gradient(135deg, #e2e8f0, #cbd5e1); }
  .app-mark { color: #fff; font: 800 1.7rem/1 -apple-system, BlinkMacSystemFont, sans-serif; }
  .web-mark { color: #334155; font-size: 1.7rem; font-weight: 800; }

  .external-link-content { min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .external-link-content strong { color: #0f172a; font-size: 1rem; line-height: 1.45; }
  .external-link-description { color: #64748b; font-size: 0.84rem; line-height: 1.55; }
  .external-link-site { color: #2563eb; font-size: 0.78rem; font-weight: 700; }

  @media (max-width: 480px) {
    .external-link-card { align-items: flex-start; padding: 0.85rem; gap: 0.8rem; }
    .external-link-icon { width: 50px; height: 50px; flex-basis: 50px; }
    .external-link-icon img { width: 27px; height: 34px; }
    .external-link-content strong { font-size: 0.92rem; }
    .external-link-description { font-size: 0.78rem; }
  }
</style>
