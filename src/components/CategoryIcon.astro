---
interface Props {
  icon: string;
  iconImage?: string;
  class?: string;
}

const { icon, iconImage, class: className = '' } = Astro.props;
---

{iconImage ? (
  <img src={iconImage} alt="" class:list={['category-icon-image', className]} aria-hidden="true" />
) : (
  <span class={className} aria-hidden="true">{icon}</span>
)}

<style>
  .category-icon-image {
    display: inline-block;
    width: 1.25em;
    height: 1.45em;
    object-fit: contain;
    vertical-align: middle;
    flex: 0 0 auto;
  }
</style>
